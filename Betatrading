@dataclass
class TokenCandidate:
    mint: str
    symbol: str
    name: str
    pair_address: str
    liquidity_usd: float
    volume_h1: float
    price_usd: float
    age_minutes: float
    reason: str = ""

@dataclass
class Position:
    mint: str
    symbol: str
    entry_price: float
    size_usd: float
    size_tokens: float
    entry_time: datetime
    reason: str
    status: str = "OPEN"  # OPEN / CLOSED
    exit_price: Optional[float] = None
    pnl_usd: float = 0.0
    exit_reason: str = ""

@dataclass
class EquityState:
    balance: float = 100.0          # starting paper equity
    peak: float = 100.0
    wins: int = 0
    losses: int = 0
    trades: List[Position] = field(default_factory=list)
    open_positions: Dict[str, Position] = field(default_factory=dict)

